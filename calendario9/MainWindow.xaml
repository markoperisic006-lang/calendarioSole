<Window x:Class="Login.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendario de bloqueos"
        Height="780" Width="1240" MinHeight="660" MinWidth="1020"
        Background="#181820" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Language="es-ES"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>

        <!-- Botón redondeado: el color se pone con Background en cada botón -->
        <Style x:Key="Boton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#30313E"/>
                                <Setter Property="Foreground" Value="#6F7188"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Elementos de la lista de bloqueos -->
        <Style x:Key="ItemLista" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                Margin="0,2" Padding="12,8" Cursor="Hand">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#272837"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33355A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- =====================================================
             PANTALLA PRINCIPAL
             ===================================================== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- Barra superior: navegación (izquierda) + leyenda 2x2 (derecha) -->
            <Grid Grid.Row="0" Grid.Column="0" Margin="20,16,24,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource Boton}" Background="#20212C" Content="‹"
                            FontSize="22" Width="46" Height="42" Click="BtnPrev_Click"/>
                    <TextBlock x:Name="TxtMes" Width="260" TextAlignment="Center" VerticalAlignment="Center"
                               FontSize="26" FontWeight="Bold" Foreground="#EBECF5"/>
                    <Button Style="{StaticResource Boton}" Background="#20212C" Content="›"
                            FontSize="22" Width="46" Height="42" Click="BtnNext_Click"/>
                    <Button Style="{StaticResource Boton}" Background="#6366F1" Content="Hoy"
                            Width="84" Height="42" Margin="14,0,0,0" Click="BtnHoy_Click"/>
                </StackPanel>

                <UniformGrid Grid.Column="2" Columns="2" Rows="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#22A060" VerticalAlignment="Center"/>
                        <TextBlock Text="Libre" Foreground="#8C8FA5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#EAB308" VerticalAlignment="Center"/>
                        <TextBlock Text="Festivo" Foreground="#8C8FA5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,0">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#E14040" VerticalAlignment="Center"/>
                        <TextBlock Text="Ocupado" Foreground="#8C8FA5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="14" Height="14" CornerRadius="7" Background="#5E617A" VerticalAlignment="Center"/>
                        <TextBlock Text="Fin de semana" Foreground="#8C8FA5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </UniformGrid>
            </Grid>

            <!-- Cabecera de días de la semana -->
            <UniformGrid Grid.Row="1" Grid.Column="0" Columns="7" Margin="14,4,14,4">
                <TextBlock Text="LUN" TextAlignment="Center" Foreground="#8C8FA5" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="MAR" TextAlignment="Center" Foreground="#8C8FA5" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="MIÉ" TextAlignment="Center" Foreground="#8C8FA5" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="JUE" TextAlignment="Center" Foreground="#8C8FA5" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="VIE" TextAlignment="Center" Foreground="#8C8FA5" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="SÁB" TextAlignment="Center" Foreground="#6366F1" FontWeight="Bold" FontSize="12"/>
                <TextBlock Text="DOM" TextAlignment="Center" Foreground="#6366F1" FontWeight="Bold" FontSize="12"/>
            </UniformGrid>

            <!-- Las 42 celdas se crean en el código -->
            <UniformGrid x:Name="DiasGrid" Grid.Row="2" Grid.Column="0" Rows="6" Columns="7" Margin="14,0,14,10"/>

            <!-- Panel derecho (alto, como en el dibujo) -->
            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" Background="#20212C">
                <Grid Margin="18">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Selección" Foreground="#8C8FA5" FontSize="13"/>
                        <TextBlock x:Name="TxtSel" Foreground="#EBECF5" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="40"/>
                        <TextBlock Text="Haz clic en un día (o arrastra / Shift+clic para un rango) para abrir la ventana de bloqueo. Con la rueda del ratón cambias de mes."
                                   Foreground="#6F7188" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="Días bloqueados" Foreground="#8C8FA5" FontSize="13" Margin="0,22,0,8"/>

                    <ListBox x:Name="ListaBloqueos" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ItemLista}"
                             SelectionChanged="ListaBloqueos_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}"
                                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Rango}" Foreground="#EBECF5" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Tipo}" Foreground="#8C8FA5" FontSize="11"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Button x:Name="BtnDesbloquear" Grid.Row="3" Style="{StaticResource Boton}"
                            Background="#E14040" Content="Desbloquear" Height="46" Margin="0,14,0,0"
                            IsEnabled="False" Click="BtnDesbloquear_Click"/>
                </Grid>
            </Border>

            <!-- Barra de estado -->
            <TextBlock x:Name="TxtEstado" Grid.Row="3" Grid.ColumnSpan="2" Foreground="#8C8FA5"
                       Margin="22,6,22,10" FontSize="12.5"/>
        </Grid>

        <!-- =====================================================
             VENTANA "BLOQUEO" (según el dibujo):
             Inicio / Fin con desplegable de fecha, desplegable de motivo,
             y botones Cancelar / Bloquear
             ===================================================== -->
        <Grid x:Name="Overlay" Background="#B0000000" Visibility="Collapsed">
            <Border Width="500" CornerRadius="16" Background="#F7F8FC" Padding="28,24,28,26"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.55"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Bloqueo" FontSize="24" FontWeight="Bold" Foreground="#1F2030"/>
                    <Border Height="1" Background="#E1E3EE" Margin="0,14,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Inicio" FontWeight="SemiBold" Foreground="#6B6E85" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DpInicio" Height="40" FontSize="14" Foreground="#1F2030"
                                        VerticalContentAlignment="Center"
                                        SelectedDateChanged="Dp_SelectedDateChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Fin" FontWeight="SemiBold" Foreground="#6B6E85" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DpFin" Height="40" FontSize="14" Foreground="#1F2030"
                                        VerticalContentAlignment="Center"
                                        SelectedDateChanged="Dp_SelectedDateChanged"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Motivo" FontWeight="SemiBold" Foreground="#6B6E85" Margin="0,18,0,6"/>
                    <ComboBox x:Name="CmbTipo" Height="42" FontSize="14" Foreground="#1F2030"
                              VerticalContentAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2,2">
                                    <Ellipse Width="12" Height="12" Fill="{Binding Color}"
                                             Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Nombre}" Foreground="#1F2030"
                                               FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock x:Name="TxtResumen" Margin="0,16,0,0" FontSize="12.5"
                               Foreground="#6B6E85" TextWrapping="Wrap" MinHeight="34"/>

                    <Grid Margin="0,22,0,0">
                        <!-- Solo aparece si en el rango hay días ocupados/festivos -->
                        <Button x:Name="BtnDlgDesbloquear" Style="{StaticResource Boton}"
                                Background="#FCE4E4" Foreground="#C62828" Content="Desbloquear"
                                Width="140" Height="44" HorizontalAlignment="Left"
                                Visibility="Collapsed" Click="BtnDlgDesbloquear_Click"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Boton}" Background="#E6E8F2" Foreground="#1F2030"
                                    Content="Cancelar" Width="110" Height="44" Click="BtnCancelar_Click"/>
                            <Button x:Name="BtnBloquear" Style="{StaticResource Boton}" Background="#6366F1"
                                    Content="Bloquear" Width="130" Height="44" Margin="10,0,0,0"
                                    Click="BtnBloquear_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
